#
# /odm from the logical partition odm_a (slot a) of super, mapped by
# dmsetup-dynparts.service. dhd skips this fstab entry (makefstab_skip_entries
# in droid-hal-pdx246); fstab.default: ext4, ro, logical, slotselect.

[Unit]
Description=Droid mount for /odm
Requires=dmsetup-dynparts.service
After=dmsetup-dynparts.service
Before=local-fs.target

[Mount]
What=/dev/mapper/dynpart-odm_a
Where=/odm
Type=ext4
Options=ro
# Default is 90 s, too long to wait for a partition that is not there.
TimeoutSec=10

[Install]
WantedBy=local-fs.target
