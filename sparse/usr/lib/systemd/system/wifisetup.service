#
# Brings the WLAN firmware up before connman starts (see wlan-driver-on.sh).

[Unit]
Description=Start the qcacld-3.0 WLAN driver
After=droid-hal-init.service
Before=connman.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /usr/bin/droid/wlan-driver-on.sh

[Install]
WantedBy=network.target
