#
# Creates the configfs gadget skeleton usb-moded needs and, as a bring-up aid,
# forces the dwc3 glue into peripheral mode when no UDC has appeared 30 s after
# droid-hal-init (see the script). Pulled in by
# usb-moded.service.d/50-configfs-setup.conf; usb-moded starts after it, so it
# finds the UDC.

[Unit]
Description=Prepare the configfs USB gadget for usb-moded
After=local-fs.target droid-hal-init.service
Before=usb-moded.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/usb-moded-configfs-setup.sh
# configfs wait (10 s) + UDC wait (30 s) + settle (5 s), with margin.
TimeoutStartSec=90
