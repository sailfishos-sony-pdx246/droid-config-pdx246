#
# Device-specific additions to sparse-16's disabled_services.rc (which stays as
# it is). droid-hal-init parses this directory before /vendor and /odm, so a
# definition here wins over a vendor one without "override". Every entry needs
# a "user" line: Android 16 init rejects services without one when
# ro.vendor.api_level > 202404 (service_parser.cpp); pdx246 has 34, but keep it.
#
# Not here, on purpose:
# - vendor.audio-hal: sparse-16 disables android.hardware.audio.service, but
#   pdx246's definition (/vendor/etc/init/android.hardware.audio.service_64.rc)
#   has "override" and replaces that stub. That is wanted: audio.hidl_compat
#   forwards to this service.
# - vendor.qti.vibrator: idle without the Android framework.
# - vendor.usb-hal (QTI IUsb, vendor/qcom/opensource/usb/hal/Usb.cpp): its
#   g1 and glue writers run only on binder client calls: the uevent thread
#   started by setCallback (UDC bind on a UDC "add" uevent, MaxPower 0 under
#   USB-PD), enableUsbData (g1/UDC "none" or rebind) and resetUsbPort (glue
#   mode). No client exists under Sailfish OS. Stub it if logcat from
#   android.hardware.usb-service.qti ever shows "creating thread", "Binding
#   UDC", "enableUsbData" or "resetUsbPort".

# Sony's diagnostics/usage-data daemon (init.sony.idd.rc); nothing in Sailfish
# OS consumes its output. The 10 IV/10 V port disables it as well.
service iddd /vendor/bin/iddd_HYBRIS_DISABLED
    user root

# atrace HAL (vendor trace categories for atrace/Perfetto); nothing in Sailfish
# OS uses it. Its constructor CHECKs that tracefs is mounted
# (hardware/interfaces atrace/1.0/default AtraceDevice.cpp), and nothing mounts
# it here: droid-hal-init's mount builtin is a no-op (hybris patch 0024), the
# GKI kernel has CONFIG_TRACEFS_DISABLE_AUTOMOUNT=y and dhd's makefstab skips
# /sys/kernel/tracing. It aborted every 5 s on the third boot.
service vendor.atrace-hal-1-0 /vendor/bin/hw/android.hardware.atrace@1.0-service_HYBRIS_DISABLED
    user root

# QTI's /vendor/bin/qti (vendor dataqti.rc, class main), the USB RmNet /
# tethering helper of the Android data stack; mobile data itself goes through
# netmgrd/ipacm and oFono. It exited every 10 s on the fifth boot (244
# restarts).
service vendor.dataqti /vendor/bin/qti_HYBRIS_DISABLED
    user root

# adbd from the com.android.adbd APEX ("override", disabled). Once the
# compressed APEXes are active, its definition would be added; this stub is not
# "updatable", so init rejects the APEX override ("cannot update a
# non-updatable service"), like sparse-16's bpfloader stub does for tethering's
# bpfloader (which carries reboot_on_failure). Never mark these stubs updatable.
service adbd /apex/com.android.adbd/bin/adbd_HYBRIS_DISABLED
    user root

# usbd (system/core/usbd; class late_start, oneshot) asks the QTI gadget HAL
# for MTP about 10 s into boot. The HAL then writes "none" to g1/UDC (an unbind
# in this kernel, configfs.c:310) and 18d1:4ee1, os_desc/use=1 and device class
# 0 into usb-moded's gadget g1. usb-moded owns g1 here.
service usbd /system/bin/usbd_HYBRIS_DISABLED
    user root
    oneshot
    disabled

# The QTI USB gadget HAL (IUsbGadget, class hal). usbd was its only client; it
# runs as system and would otherwise act on g1 for any future client.
service vendor.usbgadget-hal /vendor/bin/hw/android.hardware.usb.gadget-service.qti_HYBRIS_DISABLED
    user root
